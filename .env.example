# Verbindung zur Supabase-Datenbank. Kopie als .env anlegen (wird nicht eingecheckt).
# Beide Werte stehen im Supabase-Dashboard unter Project Settings -> API.
# Der veröffentlichbare Schlüssel ist für die App gedacht; der Service-Schlüssel gehört NIE hierher.
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
